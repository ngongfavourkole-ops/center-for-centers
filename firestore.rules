rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'ngongfavourkole@gmail.com' ||
          request.auth.token.email.lower() == 'admin@centerforcenters.cm'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Organizations collection
    // Document ID is the owner's UID
    // Owners self-registered at /organizations/{uid}. Team-managed places (added by admins)
    // have a random id and an empty ownerUid until an admin approves a claim and sets ownerUid.
    match /organizations/{orgId} {
      function isOwner() {
        return isSignedIn() && resource.data.ownerUid == request.auth.uid;
      }

      // Anyone can read approved places; owners and admins can also read unpublished ones
      allow get: if resource.data.status == 'approved' || isOwner() || isAdmin();
      allow list: if resource.data.status == 'approved' || isOwner() || isAdmin();

      // Create: owners create their own doc with status 'pending'; admins can create anything
      // (including approved team-managed places)
      allow create: if (
        isAdmin() || (
          isSignedIn() &&
          request.auth.uid == orgId &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.isSample == false &&
          request.resource.data.get('managedBy', 'owner') == 'owner'
        )
      );

      // Update: owners edit their place but it goes back to 'pending' and they cannot hand it
      // to someone else or mark it team-managed. Admins can update anything.
      allow update: if (
        isAdmin() || (
          isOwner() &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.isSample == resource.data.isSample &&
          request.resource.data.get('managedBy', 'owner') == 'owner'
        )
      );

      // Delete: admins, or the owner of a self-registered profile
      allow delete: if isAdmin() || (isOwner() && request.auth.uid == orgId);
    }

    // Claims on team-managed places. Only admins can approve (which sets the place's ownerUid).
    match /claims/{claimId} {
      allow create: if isSignedIn() &&
        request.resource.data.claimantUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.orgId is string &&
        request.resource.data.relationship is string && request.resource.data.relationship.size() <= 200 &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 40 &&
        request.resource.data.verificationDetails is string && request.resource.data.verificationDetails.size() <= 2000 &&
        get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.managedBy == 'team';
      allow read: if isAdmin() || (isSignedIn() && resource.data.claimantUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Opportunities collection
    match /opportunities/{opportunityId} {
      // Public read for approved
      // Admins can read any
      // Owners can read their own opportunities
      allow get: if resource.data.status == 'approved' || (isSignedIn() && (resource.data.orgId == request.auth.uid || isAdmin()));
      allow list: if resource.data.status == 'approved' || (isSignedIn() && (resource.data.orgId == request.auth.uid || isAdmin()));

      // Create: Org owner can create opportunities for their org with status 'pending'
      // Admins can create any (including sample or approved)
      allow create: if (
        isAdmin() || (
          isSignedIn() &&
          request.resource.data.orgId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.isSample == false
        )
      );

      // Update: Org owner can update their own opportunity, but status must be 'pending'
      // Admins can update any field including approving/rejecting
      allow update: if (
        isAdmin() || (
          isSignedIn() &&
          resource.data.orgId == request.auth.uid &&
          request.resource.data.orgId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.isSample == resource.data.isSample
        )
      );

      // Delete: Org owner or Admin
      allow delete: if isAdmin() || (isSignedIn() && resource.data.orgId == request.auth.uid);
    }

    // Reports collection
    match /reports/{reportId} {
      // Anyone can create a report
      allow create: if request.resource.data.targetId is string &&
                       request.resource.data.reason is string &&
                       request.resource.data.details is string;
      // Only admins can read, update, or delete reports
      allow read, update, delete: if isAdmin();
    }
  }
}
